# This env file should be checked into source control
# This is the place for default values for all environments
# Values in `.env.local` and `.env.production` will override these values

# `blitz start` picks this up.
# I found sometimes you can't use this in other config properties. Could be a Windows thing.
PORT=10455

# DATABASE_URL="file:./db.sqlite"
# DATABASE_URL="mysql://localhost:3306/cmdb"
# DATABASE_SCHEMA="cmdb"

# NB: manage google login tokens / apps / whatever @ 
# https://console.cloud.google.com/apis/credentials?project=cafe-marche-web
# Make sure you authorize the redirect URI: http://localhost:10455/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL="http://localhost:10455/api/auth/google/callback"

# GOOGLE_ANALYTICS_ID_BACKSTAGE=""
# GOOGLE_ANALYTICS_ID_PUBLIC=""

# Admin bootstrap system
# never place these values here; place in .env.local.
# visit https://your-app-url/auth/admin-bootstrap
# to gain sysadmin rights for logged-in users matching the given email and can
# supply the right secret. one-time use only so this needs to be changed.
# see deployment.md for details.
# CMDB_ADMIN_BOOTSTRAP_EMAIL=example@example.com
# CMDB_ADMIN_BOOTSTRAP_SECRET=<long-secure-secret>

# relative to the blitz root dir. that is, the same dir with types.ts and THIS config file.
# FILE_UPLOAD_PATH="uploads"

# Auth needs absolute URLs; configure that here.
# BASE_URL should include the slash!
# CMDB_BASE_URL="http://localhost:$PORT/"
# CMDB_LOGIN_SUCCESS_REDIRECT="http://localhost:$PORT/backstage"

# https://blitzjs.com/docs/auth-setup
# SESSION_SECRET_KEY=

