model MenuLink {
  id        Int    @id @default(autoincrement())
  publicId  String @unique @db.Char(16)
  sortOrder Int    @default(0)

  realm String? @db.VarChar(768)

  applicationPage String? @db.VarChar(768) // section name where to house this, or a custom section name
  groupName       String  @db.VarChar(768) // freeform group id to group links together separated by divider
  groupCssClass   String  @db.VarChar(768)

  itemCssClass String @db.VarChar(768)
  linkType     String @db.VarChar(768) // external, wiki

  // for external, this is a URL
  // for application, this is empty.
  // for wiki, this is the slug
  externalURI String? @db.MediumText
  wikiSlug    String? @db.VarChar(768)

  iconName  String?                @db.VarChar(768)
  captionId Int
  caption   DynamicLocalizedString @relation("MenuLink_caption", fields: [captionId], references: [id], onDelete: Restrict)

  visiblePermissionId Int?
  visiblePermission   Permission? @relation("MenuLink_visiblePermission", fields: [visiblePermissionId], references: [id], onDelete: SetNull)

  createdByUserId Int?
  createdByUser   User?    @relation("MenuLink_createdByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  bandId Int
  band   Band @relation("MenuLink_band", fields: [bandId], references: [id], onDelete: Restrict) // Bands are soft-deleted; remove content explicitly before a hard delete.

  actions Action[] @relation("Action_menuLink")

  @@index([captionId])
  @@index([realm])
  @@index([visiblePermissionId])
  @@index([bandId])
}

