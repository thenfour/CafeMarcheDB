// specific to café marché; does not participate in general behaviors like localization
model FrontpageGalleryItem {
  id            Int     @id @default(autoincrement())
  publicId      String  @unique @db.Char(16)
  isDeleted     Boolean @default(false) //  soft delete. when hidden, users won't see them.
  caption       String  @db.MediumText // markdown
  caption_nl    String? @db.MediumText // markdown
  caption_fr    String? @db.MediumText // markdown
  sortOrder     Int     @default(0)
  fileId        Int
  file          File    @relation("FrontpageGalleryItem_file", fields: [fileId], references: [id], onDelete: Cascade)
  displayParams String  @db.MediumText // JSON of GalleryImageDisplayParams

  createdByUserId     Int? // required in order to know visibility when visiblePermissionId is NULL
  createdByUser       User?       @relation("FrontpageGalleryItem_createdByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  visiblePermissionId Int?
  visiblePermission   Permission? @relation("FrontpageGalleryItem_visiblePermission", fields: [visiblePermissionId], references: [id], onDelete: SetNull)
  actions             Action[]    @relation("Action_frontpageGalleryItem")

  @@index([isDeleted])
  @@index([sortOrder])
  @@index([fileId])
  @@index([visiblePermissionId])
}

model CustomLink {
  id                  Int     @id @default(autoincrement())
  publicId            String  @unique @db.Char(16)
  name                String  @db.VarChar(768) // multilingual; not localized.
  description         String  @db.MediumText // markdown, multilingual; not localized.
  slug                String  @db.VarChar(767)
  destinationURL      String? @db.VarChar(768)
  redirectType        String // potentially various options like temporary / permanent redirect etc.
  fileId              Int?
  file                File?   @relation("CustomLink_file", fields: [fileId], references: [id], onDelete: SetNull)
  forwardQuery        Boolean @default(false) // forward the query string?
  intermediateMessage String? @db.MediumText // for intermediate page type, this is the message users will see.

  createdByUserId Int?
  createdByUser   User?    @relation("CustomLink_createdByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  bandId Int
  band   Band @relation("CustomLink_band", fields: [bandId], references: [id], onDelete: Restrict) // Bands are soft-deleted; remove content explicitly before a hard delete.

  actions Action[]          @relation("Action_customLink")
  visits  CustomLinkVisit[] @relation("CustomLinkVisit_customLink")

  @@unique([bandId, slug])
  @@index([name])
  @@index([fileId])
  @@index([bandId])
}

model CustomLinkVisit {
  id           Int      @id @default(autoincrement())
  customLinkId Int
  visitedAt    DateTime @default(now())
  visitorIP    String?  @db.VarChar(256)
  userAgent    String?  @db.MediumText
  referrerURL  String?  @db.MediumText
  URI          String?  @db.MediumText

  customLink CustomLink @relation("CustomLinkVisit_customLink", fields: [customLinkId], references: [id], onDelete: Cascade)
}

model WikiPage {
  id        Int     @id @default(autoincrement())
  publicId  String  @unique @db.Char(16)
  slug      String  @db.VarChar(767) // slugified name. actual display name can be changed in Revision
  namespace String? @db.VarChar(768) // the namespace part of the slug; for example "EventDescription"

  contentVersion    Int               @default(0) // Increments on every content save, including consolidated revisions.
  currentRevisionId Int?
  currentRevision   WikiPageRevision? @relation("WikiPage_currentRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)

  visiblePermissionId Int?
  visiblePermission   Permission? @relation("WikiPage_visiblePermission", fields: [visiblePermissionId], references: [id], onDelete: SetNull)

  lockedByUserId Int?
  lockedByUser   User?     @relation("WikiPage_lockedByUser", fields: [lockedByUserId], references: [id], onDelete: SetNull)
  lockAcquiredAt DateTime?
  lockExpiresAt  DateTime?
  lockId         String? // users can open a page more than once; this is associated to the specific rendering tree of this editing page.
  lastEditPingAt DateTime? // Last editing activity or successful save; informational only.

  createdByUserId Int?
  createdByUser   User?     @relation("WikiPage_createdByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime? @default(now())

  bandId Int
  band   Band @relation("WikiPage_band", fields: [bandId], references: [id], onDelete: Restrict) // Bands are soft-deleted; remove content explicitly before a hard delete.

  actions     Action[]                @relation("Action_wikiPage")
  events      Event?                  @relation("Event_descriptionWikiPage")
  taggedFiles FileWikiPageTag[]       @relation("FileWikiPageTag_wikiPage")
  revisions   WikiPageRevision[]      @relation("WikiPageRevision_wikiPage")
  tags        WikiPageTagAssignment[] @relation("WikiPageTagAssignment_wikiPage")

  @@unique([bandId, slug])
  @@unique([currentRevisionId])
  @@unique([id, bandId])
  @@index([visiblePermissionId])
  @@index([namespace])
  @@index([currentRevisionId])
  @@index([lockedByUserId])
  @@index([bandId])
}

model WikiPageRevision {
  id       Int    @id @default(autoincrement())
  publicId String @unique @db.Char(16)

  wikiPageId Int
  wikiPage   WikiPage @relation("WikiPageRevision_wikiPage", fields: [wikiPageId], references: [id], onDelete: Cascade)

  name             String  @db.VarChar(768)
  content          String  @db.MediumText
  consolidationKey String? // used to group revisions together

  createdByUserId Int?
  createdByUser   User?    @relation("WikiPageRevision_createdByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  linesAdded    Int?
  linesRemoved  Int?
  prevLineCount Int?
  lineCount     Int?

  charsAdded    Int?
  charsRemoved  Int?
  sizeChars     Int?
  prevSizeChars Int?

  pageAsCurrent WikiPage? @relation("WikiPage_currentRevision")

  @@unique([consolidationKey])
  @@index([name])
  @@index([consolidationKey])
  @@index([wikiPageId])
}

model GlobalWikiPageTag {
  id            Int                    @id @default(autoincrement())
  publicId      String                 @unique @db.Char(16)
  nameId        Int
  name          DynamicLocalizedString @relation("GlobalWikiPageTag_name", fields: [nameId], references: [id], onDelete: Restrict)
