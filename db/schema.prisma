model WikiPage {
  id        Int     @id @default(autoincrement())
  slug      String  @db.VarChar(768) // slugified name. actual display name can be changed in Revision
  namespace String? @db.VarChar(768) // the namespace part of the slug; for example "EventDescription"

  contentVersion    Int               @default(0) // Increments on every content save, including consolidated revisions.
  currentRevisionId Int?
  currentRevision   WikiPageRevision? @relation(name: "CurrentRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)

  visiblePermissionId Int?
  visiblePermission   Permission? @relation(fields: [visiblePermissionId], references: [id], onDelete: SetNull)

  revisions WikiPageRevision[] @relation(name: "AllRevisions")

  lockedByUserId Int?
  lockedByUser   User?     @relation(fields: [lockedByUserId], references: [id], onDelete: SetNull)
  lockAcquiredAt DateTime?
  lockExpiresAt  DateTime?
  lockId         String? // users can open a pagk more than once; this is associated to the specific rendering tree of this editing page.
  lastEditPingAt DateTime? // Last editing activity or successful save; informational only.

  createdByUserId Int?
  createdByUser   User?     @relation(name: "WikiPageCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime? @default(now())

  events  Event?   @relation("eventDescriptionWikiPage")
  actions Action[]

  taggedFiles FileWikiPageTag[]
  tags        WikiPageTagAssignment[]

  @@unique([slug])
  @@unique([currentRevisionId])
  @@index([visiblePermissionId])
  @@index([namespace])
  @@index([currentRevisionId])
  @@index([lockedByUserId])
}

