model Song {
  id             Int    @id @default(autoincrement())
  publicId       String @unique @db.Char(16)
  name           String @db.VarChar(768) // multilingual; not localized.
  aliases        String @default("") @db.VarChar(768) // multilingual; not localized.
  description    String @db.MediumText // multilingual; not localized.
  startBPM       Int?
  endBPM         Int?
  introducedYear Int? // purposely fuzzy

  isDeleted Boolean @default(false)

  lengthSeconds Int? // length. this is approximate, and could vary wildly esp. considering variations.
  // so what about variations like roger variete, or tango long/short versions? do we relate them? or score stuff? i think don't bother; maybe there can be related songs or something but not yet.

  // LSMB: add band ownership and update metadata.
  bandId          Int
  band            Band     @relation("Song_band", fields: [bandId], references: [id], onDelete: Restrict) // Remove content explicitly before hard-deleting its band.
  updatedAt       DateTime @updatedAt
  updatedByUserId Int?
  updatedByUser   User?    @relation("Song_updatedByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdByUserId Int? // required in order to know visibility when visiblePermissionId is NULL
  createdByUser   User? @relation("Song_createdByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  visiblePermissionId Int? // which permission determines visibility, when NULL, only visible by admins + creator
  visiblePermission   Permission? @relation("Song_visiblePermission", fields: [visiblePermissionId], references: [id], onDelete: SetNull)

  // Pinned recording - the canonical recording for this song
  pinnedRecordingId Int?
  pinnedRecording   File?                    @relation("Song_pinnedRecording", fields: [pinnedRecordingId], references: [id], onDelete: SetNull)
  actions           Action[]                 @relation("Action_song")
  credits           SongCredit[]             @relation("SongCredit_song")
  tags              BandSongTagAssociation[] @relation("BandSongTagAssociation_song")
  songLists         EventSongListSong[]      @relation("EventSongListSong_song")
  taggedFiles       FileSongTag[]            @relation("FileSongTag_song")

  @@unique([id, bandId])
  @@index([name])
  @@index([aliases])
  @@index([isDeleted])
  @@index([visiblePermissionId])
  @@index([bandId])
}

