model BandWikiPageTag {
  id                  Int                     @id @default(autoincrement())
  publicId            String                  @unique @db.Char(16)
  globalWikiPageTagId Int?
  globalWikiPageTag   GlobalWikiPageTag?      @relation("BandWikiPageTag_globalWikiPageTag", fields: [globalWikiPageTagId], references: [id], onDelete: Restrict)
  nameId              Int?
  name                DynamicLocalizedString? @relation("BandWikiPageTag_name", fields: [nameId], references: [id], onDelete: Restrict)
